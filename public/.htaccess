# OFF MARKET — static export hosting (Hostinger public_html / Apache)

Options -Indexes
DirectoryIndex index.html

# Legacy redirect (previously handled by Next.js config)
RedirectMatch 301 ^/infrastructure/?$ /sur-plan/

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Serve existing files/directories as-is
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # trailingSlash export: map "/path" to "/path/index.html"
  RewriteCond %{REQUEST_FILENAME}/index.html -f
  RewriteRule ^(.*)$ $1/index.html [L]

  # Fallback to the static 404 page
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ /404.html [L]
</IfModule>

# Long-cache immutable assets (they are versioned with ?v=…)
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|woff2?|ttf|otf|eot|jpg|jpeg|png|webp|avif|gif|svg|ico|mp4|webm)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
