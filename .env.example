# OFF MARKET — environment variables
#
# Copy to `.env.local` for local dev, or set in Hostinger hPanel
# (App → Environment variables) for production.

# Google Analytics 4 measurement ID (format: G-XXXXXXXXXX).
# Leave empty to disable analytics — nothing loads and no errors occur.
#
# NOTE: this is a NEXT_PUBLIC_ variable, so it is inlined at BUILD time.
# On Hostinger, set it BEFORE the build/deploy runs so it is baked in.
NEXT_PUBLIC_GA_ID=

# ---------------------------------------------------------------------------
# Lead / newsletter email notifications (server-side only — never NEXT_PUBLIC_)
# ---------------------------------------------------------------------------

# Resend API key (https://resend.com). REQUIRED in production — without it,
# /api/leads returns email_not_configured and the contact form shows an error.
# Hostinger hPanel → website → Environment variables → add, then Redeploy/Restart.
RESEND_API_KEY=

# Verified sender for the offmarketofficial.com domain in Resend.
# Prefer: OFF MARKET <noreply@offmarketofficial.com>
# If noreply is not verified, use the exact verified address from Resend
# (e.g. OFF MARKET <onboarding@resend.dev> only for sandbox tests).
EMAIL_FROM="OFF MARKET <noreply@offmarketofficial.com>"

# Fixed internal recipient for all form notifications.
# The server enforces this address; do not expose or override it from the browser.
EMAIL_TO=contact@offmarketofficial.com
# Optional alias — used only if EMAIL_TO is unset.
CONTACT_EMAIL=contact@offmarketofficial.com

# Local/CI testing only. When "1", builds the email and returns success without
# calling Resend. Do NOT set this on Hostinger production.
# Local `next start` may use NODE_ENV=production — EMAIL_DRY_RUN=1 still works
# unless DISALLOW_EMAIL_DRY_RUN=1.
EMAIL_DRY_RUN=
DISALLOW_EMAIL_DRY_RUN=

# ---------------------------------------------------------------------------
# Rate limiting / anti-abuse (server-side only — never NEXT_PUBLIC_)
# ---------------------------------------------------------------------------

# Preferred durable shared store (multi-instance / serverless): Upstash Redis.
# When both are set, all rate-limit + idempotency records use Upstash.
# On Hostinger single-node, these may be left empty — filesystem store is used.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional pepper for hashing IP / email / payload fingerprints.
# Prefer a dedicated secret (do not reuse public values).
RATE_LIMIT_HASH_SECRET=

# Trusted client-IP header from the hosting reverse proxy.
# Hostinger/nginx: x-real-ip (default). Cloudflare: cf-connecting-ip.
# Do NOT set this to an untrusted client-controlled header.
RATE_LIMIT_TRUSTED_IP_HEADER=x-real-ip

# Only enable if your edge proxy appends X-Forwarded-For safely.
# When "1", the left-most X-Forwarded-For hop is used as a fallback.
RATE_LIMIT_TRUST_X_FORWARDED_FOR=

# Store selection when Upstash is unset:
# - unset / filesystem: durable on a single Node host (Hostinger default)
# - memory: ephemeral and local-only; requires RATE_LIMIT_ALLOW_MEMORY=1
RATE_LIMIT_STORE=
RATE_LIMIT_ALLOW_MEMORY=
RATE_LIMIT_FS_DIR=

# When "1", reject submissions that omit formStartedAt (strict timing).
RATE_LIMIT_REQUIRE_STARTED_AT=
